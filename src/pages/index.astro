---
import Layout from '../layouts/Layout.astro';
import softwares from '../data/softwares.json';
---

<Layout title="Portal Oficial de Comparações | As Melhores Ofertas de Software">
	
	<!-- Estilos CSS Extra para Hover e Interatividade Premium -->
	<style>
		.software-card {
			transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.software-card:hover {
			transform: translateY(-6px);
			box-shadow: 0 20px 40px -15px rgba(2, 132, 199, 0.15) !important;
			border-color: #0ea5e9 !important;
		}
		.cta-button {
			transition: all 0.2s ease;
		}
		.cta-button:hover {
			filter: brightness(1.1);
			transform: scale(1.02);
		}
	</style>

	<!-- Hero Section - Psicologia de Recompensa Imediata -->
	<section style="text-align: center; padding: 50px 0 70px 0; max-width: 850px; margin: 0 auto;">
		<div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); padding: 6px 18px; border-radius: 30px; margin-bottom: 24px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);">
			<span style="width: 8px; height: 8px; background-color: #10b981; border-radius: 50%; display: inline-block;"></span>
			<span style="color: #047857; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.02em;">OFERTAS EXCLUSIVAS E VERIFICADAS • 2026</span>
		</div>
		
		<h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; margin: 0 0 20px 0; letter-spacing: -0.03em; line-height: 1.15;">
			<span style="background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: #0284c7;">Decisões de Software</span> <br/>
			<span style="color: #0f172a; -webkit-text-fill-color: #0f172a !important;">Sem Erros nem Viés</span>
		</h1>
		
		<p style="color: #475569; font-size: 1.2rem; margin: 0 auto 35px auto; max-width: 700px; line-height: 1.7;">
			Poupa tempo e dinheiro. Comparações diretas e os preços mais competitivos do mercado para equipar a tua empresa com total segurança.
		</p>

		<!-- Barra de Pesquisa de Alta Performance -->
		<div style="position: relative; max-width: 580px; margin: 0 auto 20px auto;">
			<input 
				type="text" 
				id="searchBar" 
				placeholder="Pesquisar por software, CRM, ERP, ferramentas..." 
				style="width: 100%; background: #ffffff; border: 2px solid #cbd5e1; color: #0f172a; padding: 20px 20px 20px 52px; border-radius: 16px; font-size: 1rem; outline: none; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);"
			/>
			<svg style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); width: 22px; height: 22px; color: #0284c7;" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
		</div>

		<!-- Gatilhos de Confiança Absoluta (Social Proof) -->
		<div style="display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; color: #64748b; font-size: 0.88rem; font-weight: 600; margin-top: 20px;">
			<span style="display: flex; align-items: center; gap: 6px;">🛡️ Análises Independentes</span>
			<span style="display: flex; align-items: center; gap: 6px;">⚡ Descontos Atualizados</span>
			<span style="display: flex; align-items: center; gap: 6px;">⭐ Escolhas de Confiança</span>
		</div>
	</section>

	<!-- Grelha de Ofertas Otimizada para Cliques -->
	<section id="catalogo" style="margin-bottom: 60px;">
		<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 30px; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px;">
			<h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0;">Ferramentas em Destaque</h2>
			<span style="color: #64748b; font-size: 0.9rem; font-weight: 600;" id="counterResults">{softwares.length} ofertas disponíveis</span>
		</div>
		
		<div id="gridSoftwares" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px;">
			{softwares.map((item) => (
				<article class="software-card" data-title={item.titulo.toLowerCase()} data-desc={item.descricao.toLowerCase()} style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);">
					<div>
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
							<span style="background: rgba(2, 132, 199, 0.1); color: #0284c7; padding: 6px 14px; border-radius: 8px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">{item.categoria}</span>
							<div style="display: flex; gap: 10px; font-size: 0.85rem; font-weight: 800; background: #f8fafc; padding: 4px 10px; border-radius: 8px; border: 1px solid #e2e8f0;">
								<span style="color: #b45309;" title="Score Opção A">⭐ {item.scoreAlpha}</span>
								<span style="color: #6d28d9;" title="Score Opção B">⭐ {item.scoreBeta}</span>
							</div>
						</div>
						
						<h3 style="margin: 0 0 12px 0; font-size: 1.4rem; font-weight: 800; color: #0f172a;">
							<a href={`/comparacoes/${item.slug}`} style="color: inherit; text-decoration: none;">{item.titulo}</a>
						</h3>
						
						<p style="color: #475569; margin: 0 0 28px 0; font-size: 0.95rem; line-height: 1.6;">{item.descricao}</p>
					</div>

					<div style="border-top: 1px solid #f1f5f9; padding-top: 20px; display: flex; justify-content: space-between; align-items: center;">
						<span style="font-size: 0.85rem; color: #10b981; font-weight: 700; display: flex; align-items: center; gap: 4px;">
							<span style="width: 6px; height: 6px; background-color: #10b981; border-radius: 50%;"></span> Melhor Preço Verificado
						</span>
						<a href={`/comparacoes/${item.slug}`} class="cta-button" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: #ffffff; padding: 12px 20px; border-radius: 12px; text-decoration: none; font-weight: 700; font-size: 0.9rem; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35); display: inline-block;">Ver Oferta &rarr;</a>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- Script de Pesquisa Instantânea -->
	<script>
		const searchInput = document.getElementById('searchBar') as HTMLInputElement;
		const cards = document.querySelectorAll('.software-card');
		const counter = document.getElementById('counterResults');

		searchInput?.addEventListener('input', (e) => {
			const term = (e.target as HTMLInputElement).value.toLowerCase();
			let visibleCount = 0;

			cards.forEach((card) => {
				const title = card.getAttribute('data-title') || '';
				const desc = card.getAttribute('data-desc') || '';
				if (title.includes(term) || desc.includes(term)) {
					(card as HTMLElement).style.display = 'flex';
					visibleCount++;
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});

			if (counter) {
				counter.innerText = `${visibleCount} ofertas disponíveis`;
			}
		});
	</script>
</Layout>