---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Software A vs Software B | AuditTech">
  <main style="max-width: 800px; margin: 60px auto; padding: 0 20px; font-family: sans-serif; text-align: center;">
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
      <span style="background: rgba(2, 132, 199, 0.1); color: #0284c7; padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase;">
        Comparativo B2B
      </span>
      <h1 style="font-size: 2rem; color: #0f172a; margin: 20px 0;">
        Software A vs Software B
      </h1>
      <p style="font-size: 1.1rem; color: #64748b; line-height: 1.6; margin-bottom: 30px;">
        Esta análise detalhada está a ser finalizada para garantir os melhores dados e parcerias para a tua empresa.
      </p>
      <a href="/" style="background: #0284c7; color: #fff; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 600; display: inline-block;">
        &larr; Voltar à Página Principal
      </a>
    </div>
  </main>
</Layout>