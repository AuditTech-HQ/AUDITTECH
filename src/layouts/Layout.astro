---
import Analytics from '@vercel/analytics/astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-pt">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Análise e comparação de software B2B" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: sans-serif;">
		<slot />
		
		<Analytics />
	</body>
</html>

<style is:global>
	/* Podes manter aqui os teus estilos globais, se tiveres */
</style>