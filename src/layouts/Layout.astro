	---
	interface Props {
	title: string;
	}

	const { title } = Astro.props;
	---

	<!DOCTYPE html>
	<html lang="pt">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | AuditTech</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

		<script type="text/javascript">(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7634705-60a5-46aa-97bf-9a8f2509c36f1.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');</script>

		<style>
		*, *::before, *::after {
			box-sizing: border-box;
		}
		body {
			font-family: 'Plus Jakarta Sans', sans-serif;
			background-color: #000000;
			color: #1e293b;
			margin: 0;
			padding: 0;
			line-height: 1.6;
		}
		a {
			text-decoration: none;
			color: inherit;
		}
		</style>
	</head>
	<body>

		<header style="background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 20px 24px; position: sticky; top: 0; z-index: 100;">
		<div style="max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
			<a href="/" style="font-weight: 800; font-size: 1.4rem; color: #0f172a;">
			Audit<span style="color: #2563eb;">Tech</span>
			</a>
			<span style="background: rgba(37, 99, 235, 0.1); color: #2563eb; padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">100% Independente</span>
		</div>
		</header>

		<main style="max-width: 1100px; margin: 40px auto; padding: 0 24px; min-height: 70vh;">
		<slot />
		</main>

		<footer style="background: #ffffff; border-top: 1px solid #e2e8f0; margin-top: 80px; padding: 40px 24px; text-align: center; color: #64748b; font-size: 0.9rem;">
		<p style="margin: 0 0 10px 0;">As nossas análises são baseadas em testes rigorosos e critérios objetivos. Os links de afiliados ajudam a apoiar a nossa investigação sem custos adicionais para ti.</p>
		<p style="margin: 0; color: #94a3b8; font-size: 0.82rem;">&copy; 2026 AuditTech. Todos os direitos reservados.</p>
		</footer>

	</body>
	</html>